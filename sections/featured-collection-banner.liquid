{{ 'featured-collection-banner.css' | asset_url | stylesheet_tag }}
<script src="{{ 'featured-collection-banner.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign card_style = section.settings.pcard_layout
  assign image_ratio = section.settings.pcard_image_ratio
  assign show_vendor = section.settings.show_vendor
  assign hide_title = section.settings.hide_title
  assign current_collection = collections[section.settings.collection]
  assign product_to_show = section.settings.product_to_show | default: 6
  assign items_per_row = section.settings.items_per_row | default: 3
  assign products_per_view_mobile = section.settings.products_per_view_mobile | default: 1.2

  if card_style == null or card_style == blank
    assign card_style = settings.pcard_layout
  endif

  assign container = section.settings.container
  if container == 'w-full'
    assign container = 'container-full'
  endif

  assign animation_effect = settings.animations
  assign animated = false
  if animation_effect != 'none'
    assign animated = true
    if section.settings.animations != 'inherit'
      assign animation_effect = section.settings.animations
    endif
  endif

  assign classes = 'm-section m-featured-colelction__banner m-product-list-banner'
  if section.settings.custom_class != blank
    assign classes = classes | append: ' ' | append: section.settings.custom_class
  endif
  assign classes = classes | append: ' m-gradient' | append: ' m-color-' | append: section.settings.color_scheme

  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and current_collection != blank
    assign view_all_url = current_collection.url
  endif
%}

{% style %}
  .m-section--{{ section.id }} {
    --banner-product-gap: {{ section.settings.item_gap }}px;
    --banner-product-gap-mobile: {{ section.settings.item_gap_mobile }}px;
    --banner-products-per-row: {{ items_per_row }};
    --banner-products-per-view-mobile: {{ products_per_view_mobile }};
    --banner-row-gap: {{ section.settings.row_gap }}px;
    --banner-row-gap-mobile: {{ section.settings.row_gap_mobile }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<section class="{{ classes }} m-section--{{ section.id }}" id="featured-collection-banner-{{ section.id }}">
  <div class="{{ container }} m-section-my m-section-py">
    <div class="m-product-list-banner__wrapper">
      {% for block in section.blocks %}
        {% liquid
          assign block_image = block.settings.image
          assign block_mobile_image = block.settings.mobile_image
          assign block_image_ratio = block.settings.image_aspect_ratio | default: '3/4'
          assign block_image_fit = block.settings.image_object_fit | default: 'cover'
          assign block_image_height = block.settings.image_height | default: 620
          assign block_image_height_mobile = block.settings.image_height_mobile | default: 420
          assign block_ratio_value = block_image_ratio
          if block_ratio_value == 'adapt'
            assign block_ratio_value = ''
          endif
        %}
        <div
          class="m-product-list-banner__media m:column{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %} {{ block.settings.block_custom_class }}"
          {{ block.shopify_attributes }}
          {% if animated %}data-cascade{% endif %}
          style="--banner-image-height: {{ block_image_height }}px; --banner-image-height-mobile: {{ block_image_height_mobile }}px; --banner-image-fit: {{ block_image_fit }};{% if block_ratio_value != blank %} --banner-image-ratio: {{ block_ratio_value }};{% endif %}{% if animated %} --animation-order: {{ forloop.index }};{% endif %}"
        >
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}" class="m-product-list-banner__media-link" aria-label="{{ block.settings.title | default: section.settings.heading | escape }}">{% endif %}
            <div class="m-product-list-banner__image-frame{% if block_image_ratio == 'adapt' %} m-product-list-banner__image-frame--adapt{% endif %}">
              {% if block_image != blank %}
                <picture>
                  {% if block_mobile_image != blank %}
                    <source media="(max-width: 767px)" srcset="{{ block_mobile_image | image_url: width: 900 }}">
                  {% endif %}
                  {{ block_image | image_url: width: 1600 | image_tag: loading: 'lazy', class: 'm-product-list-banner__image', widths: '360, 540, 720, 900, 1200, 1600', sizes: '(min-width: 1024px) 38vw, 100vw' }}
                </picture>
              {% else %}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'm-placeholder-svg m-product-list-banner__placeholder' }}
              {% endif %}
            </div>
            {% if block.settings.subtitle != blank or block.settings.title != blank or block.settings.button_label != blank %}
              <div class="m-product-list-banner__image-content m-product-list-banner__image-content--{{ block.settings.content_position }} m:text-{{ block.settings.content_alignment }} m-product-list-banner__image-content--{{ block.settings.text_color }}">
                {% if block.settings.subtitle != blank %}<p class="m-product-list-banner__image-subtitle">{{ block.settings.subtitle }}</p>{% endif %}
                {% if block.settings.title != blank %}<h3 class="m-product-list-banner__image-title m-product-list-banner__image-title--{{ block.settings.text_size }}">{{ block.settings.title }}</h3>{% endif %}
                {% if block.settings.button_label != blank %}<span class="m-button {{ block.settings.button_style }} {{ block.settings.button_size }}">{{ block.settings.button_label }}</span>{% endif %}
              </div>
            {% endif %}
          {% if block.settings.link != blank %}</a>{% endif %}
        </div>
      {% endfor %}

      <div
        class="m-product-list-banner__products-panel m:column{% if section.settings.enable_product_scroll %} m-product-list-banner__products-panel--slider{% else %} m-product-list-banner__products-panel--grid{% endif %}"
        data-product-list-banner
        data-enable-slider="{{ section.settings.enable_product_scroll }}"
        data-items="{{ items_per_row }}"
        data-mobile-items="{{ products_per_view_mobile }}"
      >
        <div class="m-product-list-banner__header m:text-{{ section.settings.header_alignment }}">
          {% if section.settings.subheading != blank %}
            <p class="m-section__subheading m-product-list-banner__subheading{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">{{ section.settings.subheading }}</p>
          {% endif %}
          {% if section.settings.heading != blank %}
            <h2 class="m-section__heading {{ section.settings.heading_size }} m-product-list-banner__heading{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">{{ section.settings.heading }}</h2>
          {% endif %}
          {% if section.settings.description != blank %}
            <div class="m-section__description m-product-list-banner__description{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}">{{ section.settings.description }}</div>
          {% endif %}
          {% if section.settings.show_view_all and section.settings.view_all_label != blank %}
            <a class="m-product-list-banner__view-all{% if section.settings.view_all_style == 'button' %} m-button m-button--secondary m-button--small{% endif %}" href="{{ view_all_url | default: '#' }}">
              {{ section.settings.view_all_label }}
            </a>
          {% endif %}
        </div>

        <div class="m-product-list-banner__carousel">
          <div class="m-product-list-banner__scroller" data-product-list-banner-track>
            {% if current_collection != blank %}
              {% for product in current_collection.products limit: product_to_show %}
                <div class="m-product-list-banner__product{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"{% if animated %} data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}>
                  {% liquid
                    case card_style
                      when '1'
                        render 'product-card-1', product: product, image_ratio: image_ratio, show_vendor: show_vendor, hide_title: hide_title, index: forloop.index, animated: animated, animation_effect: animation_effect
                      when '2'
                        render 'product-card-2', product: product, image_ratio: image_ratio, show_vendor: show_vendor, hide_title: hide_title, index: forloop.index, animated: animated, animation_effect: animation_effect
                      when 'joycraft'
                        render 'product-card-joycraft', product: product, image_ratio: image_ratio, show_vendor: show_vendor, hide_title: hide_title, index: forloop.index, animated: animated, animation_effect: animation_effect
                      when '3'
                        render 'product-card-3', product: product, image_ratio: image_ratio, show_vendor: show_vendor, hide_title: hide_title, index: forloop.index, animated: animated, animation_effect: animation_effect
                      when '4'
                        render 'product-card-4', product: product, image_ratio: image_ratio, show_vendor: show_vendor, hide_title: hide_title, index: forloop.index, animated: animated, animation_effect: animation_effect
                      when '5'
                        render 'product-card-5', product: product, image_ratio: image_ratio, show_vendor: show_vendor, hide_title: hide_title, index: forloop.index, animated: animated, animation_effect: animation_effect
                      else
                        render 'product-card-1', product: product, image_ratio: image_ratio, show_vendor: show_vendor, hide_title: hide_title, index: forloop.index, animated: animated, animation_effect: animation_effect
                    endcase
                  %}
                </div>
              {% endfor %}
            {% else %}
              {% for i in (1..product_to_show) %}
                <div class="m-product-list-banner__product">
                  <div class="m-product-card m-product-card--placeholder{% if animated %} m-scroll-trigger animate--{{ animation_effect }}{% endif %}"{% if animated %} data-cascade style="--animation-order: {{ forloop.index }};"{% endif %}>
                    <div class="m-product-card__media" style="--aspect-ratio: 3/4;">
                      {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                      {{ 'product-' | append: current | placeholder_svg_tag: 'm-placeholder-svg m:object-cover m:w-full m:h-full' }}
                    </div>
                    <div class="m-product-card__name{% if settings.uppercase_prd_name %} m:uppercase{% endif %}">{{ 'homepage.onboarding.product_title' | t }}</div>
                    <div class="m-product-card__price"><p class="m-price">$19.99</p></div>
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          </div>

          {% if section.settings.enable_product_scroll %}
            <div class="m-product-list-banner__controls m-slider-controls m-slider-controls--middle-center m-slider-controls--show-nav m-slider-controls--group">
              <div class="m-slider-controls__wrapper">
                <button class="m-slider-controls__button m-slider-controls__button-prev swiper-button-prev" type="button" aria-label="Previous" data-product-list-banner-prev>
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12.5 15L7.5 10L12.5 5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="m-slider-controls__button m-slider-controls__button-next swiper-button-next" type="button" aria-label="Next" data-product-list-banner-next>
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.5 15L12.5 10L7.5 5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product list banner",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "paragraph", "content": "[Read How-to](https://foxecom.link/Xmn65X)" },
    { "type": "header", "content": "Section header" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured banner" },
    {
      "type": "select", "id": "heading_size", "label": "Heading size", "default": "h3",
      "options": [ { "label": "Medium", "value": "h3" }, { "label": "Large", "value": "h2" } ]
    },
    { "type": "html", "id": "subheading", "label": "Subheading" },
    { "type": "textarea", "id": "description", "label": "Description" },
    {
      "type": "select", "id": "header_alignment", "label": "Text alignment", "default": "left",
      "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" } ]
    },
    { "type": "checkbox", "id": "show_view_all", "label": "Show View all", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View All" },
    { "type": "url", "id": "view_all_link", "label": "View all link" },
    {
      "type": "select", "id": "view_all_style", "label": "View all style", "default": "underline",
      "options": [ { "value": "underline", "label": "Underline text" }, { "value": "button", "label": "Button" } ]
    },
    { "type": "header", "content": "General" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
    {
      "type": "select", "id": "container", "label": "Container type", "default": "container-fluid",
      "options": [ { "value": "container-fluid", "label": "Default" }, { "value": "w-full", "label": "Full width" }, { "value": "container", "label": "Use container box" } ]
    },
    { "id": "collection", "type": "collection", "label": "Collection" },
    { "type": "header", "content": "Grid settings" },
    { "type": "range", "id": "product_to_show", "label": "显示产品数量", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "items_per_row", "label": "桌面端每屏产品数", "min": 1, "max": 6, "step": 1, "default": 3 },
    {
      "type": "select", "id": "products_per_view_mobile", "label": "移动端每屏产品数", "default": "1.2",
      "options": [ { "value": "1", "label": "1" }, { "value": "1.2", "label": "1.2" }, { "value": "1.3", "label": "1.3" }, { "value": "1.5", "label": "1.5" }, { "value": "2", "label": "2" } ]
    },
    { "type": "checkbox", "id": "enable_product_scroll", "label": "启用产品轮播", "default": true },
    { "type": "range", "id": "item_gap", "label": "桌面端产品间距", "min": 0, "max": 50, "step": 2, "default": 30, "unit": "px" },
    { "type": "range", "id": "row_gap", "label": "桌面端行间距", "min": 0, "max": 50, "step": 2, "default": 30, "unit": "px" },
    { "type": "header", "content": "Product card settings" },
    {
      "type": "select", "id": "pcard_layout", "label": "Design layout", "default": "",
      "options": [ { "value": "", "label": "Use global settings" }, { "value": "1", "label": "Style 1" }, { "value": "2", "label": "Style 2" }, { "value": "3", "label": "Style 3" }, { "value": "4", "label": "Style 4" }, { "value": "5", "label": "Style 5" }, { "value": "joycraft", "label": "JoyCraft style" } ]
    },
    {
      "type": "select", "id": "pcard_image_ratio", "label": "Image aspect ratio", "default": "",
      "options": [ { "value": "", "label": "Use global settings" }, { "value": "original", "label": "Original aspect ratio" }, { "value": "1/1", "label": "1:1" }, { "value": "3/4", "label": "3:4" }, { "value": "4/3", "label": "4:3" }, { "value": "16/9", "label": "16:9" } ]
    },
    { "type": "checkbox", "id": "show_vendor", "label": "Show product vendors", "default": false },
    { "type": "checkbox", "id": "hide_title", "label": "Hide product title", "default": false },
    { "type": "header", "content": "Mobile settings" },
    { "type": "checkbox", "label": "移动端横向滚动", "id": "use_scroll_mobile", "default": false, "info": "Uncheck to display as grid" },
    { "type": "range", "id": "item_gap_mobile", "label": "移动端产品间距", "min": 0, "max": 30, "step": 2, "default": 16, "unit": "px" },
    { "type": "range", "id": "row_gap_mobile", "label": "移动端行间距", "min": 0, "max": 30, "step": 2, "default": 16, "unit": "px" },
    { "type": "header", "content": "Section Padding" },
    { "type": "range", "id": "padding_top", "label": "Padding Top", "default": 50, "min": 0, "max": 100, "step": 2, "unit": "px" },
    { "type": "range", "id": "padding_bottom", "label": "Padding Bottom", "default": 50, "min": 0, "max": 100, "step": 2, "unit": "px" },
    { "type": "header", "content": "Custom Attributes" },
    { "type": "text", "id": "custom_class", "label": "Custom classes" },
    { "type": "header", "content": "Animations" },
    {
      "type": "select", "id": "animations", "label": "Visible in the view animation", "default": "inherit",
      "options": [ { "value": "inherit", "label": "Inherit global setting" }, { "value": "fade-in", "label": "Fade in" }, { "value": "fade-in-up", "label": "Fade in up" }, { "value": "fade-in-left", "label": "Fade in left" }, { "value": "fade-in-right", "label": "Fade in right" } ]
    }
  ],
  "blocks": [
    {
      "name": "Image card",
      "type": "image_card",
      "limit": 1,
      "settings": [
        { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme" },
        {
          "type": "select", "id": "image_aspect_ratio", "label": "图片比例", "default": "3/4",
          "options": [ { "value": "adapt", "label": "原图比例" }, { "value": "1/1", "label": "1:1" }, { "value": "3/4", "label": "3:4" }, { "value": "4/3", "label": "4:3" }, { "value": "16/9", "label": "16:9" } ]
        },
        { "type": "range", "id": "image_height", "label": "桌面端图片高度", "min": 320, "max": 900, "step": 10, "unit": "px", "default": 620 },
        { "type": "range", "id": "image_height_mobile", "label": "移动端图片高度", "min": 220, "max": 700, "step": 10, "unit": "px", "default": 420 },
        {
          "type": "select", "id": "image_object_fit", "label": "图片填充方式", "default": "cover",
          "options": [ { "value": "cover", "label": "填充裁切" }, { "value": "contain", "label": "完整显示" } ]
        },
        {
          "type": "select", "id": "content_position", "label": "Content position", "default": "center_center",
          "options": [ { "value": "top_left", "label": "Top left" }, { "value": "top_center", "label": "Top center" }, { "value": "top_right", "label": "Top right" }, { "value": "center_left", "label": "Middle left" }, { "value": "center_center", "label": "Middle center" }, { "value": "center_right", "label": "Middle right" }, { "value": "bottom_left", "label": "Bottom left" }, { "value": "bottom_center", "label": "Bottom center" }, { "value": "bottom_right", "label": "Bottom right" } ]
        },
        {
          "type": "select", "id": "content_alignment", "label": "Content alignment", "default": "center",
          "options": [ { "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" } ]
        },
        {
          "type": "select", "id": "text_size", "label": "Text size", "default": "medium",
          "options": [ { "value": "small", "label": "Small" }, { "value": "medium", "label": "Medium" }, { "value": "large", "label": "Large" } ]
        },
        {
          "type": "select", "id": "text_color", "label": "Text color", "default": "inherit",
          "options": [ { "value": "white", "label": "Light" }, { "value": "black", "label": "Dark" }, { "value": "inherit", "label": "Inherit" } ]
        },
        { "type": "header", "content": "Content" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
        { "type": "url", "id": "link", "label": "Image link" },
        { "type": "textarea", "id": "subtitle", "label": "Sub heading" },
        { "type": "text", "id": "title", "label": "Heading", "default": "Image card" },
        { "type": "header", "content": "Button settings" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Button label" },
        {
          "type": "select", "id": "button_style", "label": "Button style", "default": "m-button--primary",
          "options": [ { "value": "m-button--primary", "label": "Primary button" }, { "value": "m-button--secondary", "label": "Secondary button" }, { "value": "m-button--white", "label": "White button" }, { "value": "m-button--link", "label": "Underline button" } ]
        },
        {
          "type": "select", "id": "button_size", "label": "Button size", "default": "",
          "options": [ { "value": "m-button--small", "label": "Button small" }, { "value": "", "label": "Button medium" }, { "value": "m-button--large", "label": "Button large" } ]
        },
        { "type": "header", "content": "Advanced settings" },
        { "type": "text", "id": "block_custom_class", "label": "Custom classes" },
        { "type": "header", "content": "Advanced" },
        { "type": "checkbox", "id": "enable_preload_image", "label": "Enable preload image", "info": "If this section is visible when the page loads, enabling this setting can reduce LCP and may improve site speed scores." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product list banner",
      "category": "Collection",
      "blocks": [ { "type": "image_card" } ]
    }
  ]
}
{% endschema %}
